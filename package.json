{
  "name": "riocut-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:movies": "pnpm --filter movies dev",
    "dev:sports": "pnpm --filter sports dev",
    "dev:tv": "pnpm --filter tv dev",
    "build": "turbo run build",
    "build:movies": "pnpm --filter movies build",
    "build:sports": "pnpm --filter sports build",
    "build:tv": "pnpm --filter tv build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @riocut/db db:generate",
    "db:migrate": "pnpm --filter @riocut/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @riocut/db db:migrate:deploy",
    "db:studio": "pnpm --filter @riocut/db db:studio",
    "db:seed": "pnpm --filter @riocut/db db:seed",
    "clean": "turbo run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.next apps/*/.turbo packages/*/.turbo"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0"
  }
}
