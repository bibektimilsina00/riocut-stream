{
  "name": "movies",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "TURBOPACK=1 NODE_NO_WARNINGS=1 NODE_OPTIONS='--max-old-space-size=2048' next dev --port 8000 --turbo",
    "dev:webpack": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--max-old-space-size=2048' next dev --port 8000",
    "build": "NODE_OPTIONS='--max-old-space-size=2048' next build",
    "start": "PORT=3000 HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "test": "echo 'No tests specified' && exit 0",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next .turbo node_modules",
    "db:generate": "pnpm --filter @riocut/db db:generate",
    "db:migrate": "pnpm --filter @riocut/db db:migrate",
    "db:studio": "pnpm --filter @riocut/db db:studio",
    "make-admin": "ts-node scripts/make-admin.ts"
  },
  "dependencies": {
