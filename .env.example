# ===================================================================
# Riocut + Riocut Sports monorepo environment.
# Copy to .env at repo root, plus per-app .env files for local dev
# (apps/movies/.env, apps/sports/.env).
# ===================================================================

# ---------- Postgres (shared) ----------
POSTGRES_DB=movies
POSTGRES_USER=movies
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://riocut:changeme@postgres:5432/riocut

# ---------- NextAuth (shared user pool + SSO) ----------
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true
# Cross-subdomain SSO: set cookie domain to your apex with a leading dot.
# Leave blank for local dev (cookie scoped to localhost per-port).
AUTH_COOKIE_DOMAIN=.riocut.com
# Per-app AUTH_URL — canonical NextAuth URL per subdomain.
RIOCUT_AUTH_URL=https://riocut.com
RIOCUT_SPORTS_AUTH_URL=https://sports.riocut.com

# ---------- Public URLs ----------
RIOCUT_URL=https://riocut.com
RIOCUT_SPORTS_URL=https://sports.riocut.com
NEXT_PUBLIC_BLOG_SITE_URL=https://blog.riocut.com

# ---------- Local ports ----------
RIOCUT_PORT=8000
RIOCUT_SPORTS_PORT=8001

# ---------- TMDB (movies only) ----------
TMDB_API_KEY=

# ---------- sportsrc.org (sports) ----------
# No API key required.

# ---------- Bzzoiro Sports Data / BSD (sports match-center) ----------
# Server-side only (never NEXT_PUBLIC). Powers live stats, events, lineups,
# and predictions below the player. Free key from sports.bzzoiro.com/register/
# If unset, the match-center simply doesn't render.
BSD_API_TOKEN=

# ---------- WebRTC TURN (both apps share) ----------
NEXT_PUBLIC_TURN_SERVER=turn:turn.example.com:3478
NEXT_PUBLIC_TURN_USERNAME=
TURN_PASSWORD=

# ---------- Analytics / build metadata ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_BUILD_VERSION=0.1.0
NEXT_PUBLIC_BUILD_DATE=
NEXT_PUBLIC_GIT_SHA=

# ---------- Registry / deploy ----------
RIOCUT_IMAGE_NAME=ghcr.io/bibektimilsina00/riocut-stream:latest
RIOCUT_SPORTS_IMAGE_NAME=ghcr.io/bibektimilsina00/riocut-sports:latest
REGISTRY=ghcr.io
DEPLOY_USER=
REGISTRY_TOKEN=

# PostHog analytics, session replay & error tracking (US Cloud). Project token is public.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
